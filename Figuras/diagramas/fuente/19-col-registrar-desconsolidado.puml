@startuml
!include _estilo.iuml
left to right direction
actor "Jefe tarjador" as JT
rectangle ":GestorOperacion" as GO
rectangle "o:Operacion" as O
rectangle ":SelloSeguridad" as SS
rectangle ":LineaCarga" as LC
rectangle "i:Incidencia" as I
rectangle "f:Fotografia" as F
rectangle ":SincronizadorOffline" as SO
rectangle ":GestorReportes" as GR

JT -- GO : "1: iniciarOperacion(idProgramacion) →\n2: registrarSello(idOperacion, nroSello, imagen) →\n3*[por cada lote]: registrarLote(idOperacion,\n   idLinea, cantidadRecibida, imagen) →\n4 [si hay diferencia o daño]: registrarIncidencia(\n   idOperacion, idLinea, tipo, cantidadAfectada, imagenes) →\n5: cerrarOperacion(idOperacion, imagenVacio) →"
GO -- O : "1.1: <<create>> →\n1.2: iniciar() →\n2.2, 3.3, 5.2: agregarFotografia(f) →\n5.6: cerrar() →"
GO -- SS : "2.4: <<create>> →\n2.5: verificar(declarado) →"
GO -- LC : "3.1: contrastarCantidad(cantidadRecibida) →"
GO -- I : "4.1: <<create>> →\n4.3*: adjuntarFotografia(f) →"
GO -- F : "2.1, 3.2, 4.2*, 5.1: <<create>>(imagen) →"
F -- F : "comprimir()"
GO -- SO : "2.3, 3.4, 4.4*, 5.3: encolar(f) →\n5.4: hayConectividad() →\n5.5 [hay conectividad]: sincronizarPendientes() →"
SO -- F : "5.5.1*[por cada pendiente]: marcarSubida(url) →"
GO -- GR : "5.7: generarBorrador(idOperacion) →"
@enduml
