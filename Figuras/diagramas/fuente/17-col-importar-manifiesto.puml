@startuml
!include _estilo.iuml
actor "Jefe de faena" as JF
rectangle ":GestorManifiesto" as GM
rectangle ":ServicioAduana" as SA
rectangle ":Manifiesto" as M
rectangle ":Contenedor" as C
rectangle ":LineaCarga" as L

JF --> GM : "1: m := importarManifiesto(…)"
GM --> SA : "1.1: xml := descargarXML(…)\n1.6: notificarResultadoImportacion(…)"
GM --> M : "1.2: <<create>>\n1.3: valido := validarEsquema(xml)\n1.4*[por cada contenedor]:\n    c := agregarContenedor(…)"
M --> C : "1.4.1: <<create>>"
GM --> C : "1.5*[por cada línea]:\n    l := agregarLinea(…)"
C --> L : "1.5.1: <<create>>"
@enduml
