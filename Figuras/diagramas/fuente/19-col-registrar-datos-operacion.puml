@startuml
!include _estilo.iuml
actor "Jefe tarjador" as JT
rectangle ":GestorOperacion" as GO
rectangle ":Operacion" as O
rectangle ":SelloSeguridad" as S
rectangle ":LineaCarga" as L
rectangle ":Incidencia" as I
rectangle ":Fotografia" as F
rectangle ":SincronizadorOffline" as SO
rectangle ":GestorReportes" as GR

JT -- GO : "1: iniciarOperacion(idProgramacion) ↓\n↑ o : Operacion (estado EN_EJECUCION)\n2: registrarSello(idOperacion, nroSello, imagen) ↓\n↑ estadoSello : EstadoSello\n3*[por cada lote separado por cliente]:\nregistrarLote(idOperacion, idLinea,\ncantidadRecibida, imagen) ↓\n↑ diferencia : int\n4 [diferencia != 0 o daño visible]:\nregistrarIncidencia(idOperacion, idLinea,\ntipo, cantidadAfectada, imagenes) ↓\n↑ i : Incidencia\n5: cerrarOperacion(idOperacion, imagenVacio) ↓\n↑ faena cerrada (estado FINALIZADA)"
GO -- O : "1.1: <<create>> ↓\n1.2: iniciar() ↓\n2.2, 3.3, 5.2: agregarFotografia(f) ↓\n4.2: agregarIncidencia(i) ↓\n4.5*: agregarFotografia(f) ↓\n5.4: cerrar() ↓"
GO -- S : "2.4: <<create>>(nroSello) ↓\n2.5: verificar(declarado) ↓\n↑ estadoSello : EstadoSello"
GO -- L : "3.1: contrastarCantidad(cantidadRecibida) ↓\n↑ diferencia : int"
GO -- I : "4.1: <<create>>(tipo, cantidadAfectada, l) ↓\n4.4*: adjuntarFotografia(f) ↓"
GO -up- F : "2.1, 3.2: <<create>>(imagen) ↑\n4.3*[por cada imagen]: <<create>>(imagen) ↑\n5.1: <<create>>(imagenVacio) ↑"
F -- F : "2.1.1, 3.2.1, 4.3.1, 5.1.1:\ncomprimir()"
GO -up- SO : "2.3, 3.4, 4.6*, 5.3: encolar(f) ↑"
SO -- SO : "2.3.1, 3.4.1, 4.6.1, 5.3.1:\nhayConectividad()\n2.3.2, 3.4.2, 4.6.2, 5.3.2\n[hay conectividad]:\nsincronizarPendientes()"
GO -up- GR : "5.5: generarBorrador(idOperacion) ↑\n↓ r : Reporte (estado BORRADOR)"
@enduml
