@startuml
!include _estilo.iuml
actor "Jefe tarjador" as JT
rectangle ":GestorOperacion" as GO
rectangle ":Operacion" as O
rectangle ":SelloSeguridad" as S
rectangle ":LineaCarga" as L
rectangle ":Incidencia" as I
rectangle ":Fotografia" as F
rectangle ":SincronizadorOffline" as SO
rectangle ":GestorReportes" as GR

JT --> GO : "1: o := iniciarOperacion(…)\n2: estadoSello := registrarSello(…)\n3*[por cada lote]: diferencia := registrarLote(…)\n4 [diferencia ≠ 0 o daño]: i := registrarIncidencia(…)\n5: cerrarOperacion(…)"
GO --> O : "1.1: <<create>>\n1.2: iniciar()\n4.2: agregarIncidencia(i)\n2.2, 3.3, 4.5*, 5.2: agregarFotografia(f)\n5.4: cerrar()"
GO --> S : "2.4: <<create>>\n2.5: estadoSello := verificar(…)"
GO --> L : "3.1: diferencia :=\n    contrastarCantidad(…)"
GO --> I : "4.1: <<create>>\n4.4*: adjuntarFotografia(f)"
GO -up-> F : "2.1, 3.2, 4.3*, 5.1:\n    f := <<create>>(imagen)"
F --> F : "n.1: comprimir()\n(n = 2.1, 3.2, 4.3, 5.1)"
GO -up-> SO : "2.3, 3.4, 4.6*, 5.3: encolar(f)"
SO --> SO : "n.1: hayConectividad()\nn.2 [hay conectividad]:\n    sincronizarPendientes()\n(n = 2.3, 3.4, 4.6, 5.3)"
GO -up-> GR : "5.5: r := generarBorrador(…)"
@enduml
